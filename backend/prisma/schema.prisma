
  generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// ACCOUNTS
// =====================================================================

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  phone           String?
  passwordHash    String // bcrypt or argon2 hash, never the password
  role            Role       @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions Session[]
  tokens   VerificationToken[]
  attempts Attempt[]
  orders   Order[]
}

// Login sessions kept on the server, so a session can be ended from the admin panel.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // hash of the cookie value
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// =====================================================================
// CONTENT: exams, question bank, tests
// =====================================================================

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Exam {
  id        String        @id @default(cuid())
  slug      String        @unique // e.g. "iss", "gate-st"
  name      String
  guide     Json? // facts, pattern, steps, FAQs and note, the same shape as exams.js
  sortOrder Int           @default(0)
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tests Test[]
}

// Subject and topic names. A topic can sit inside a parent, e.g. Statistics > Estimation.
model Topic {
  id       String  @id @default(cuid())
  name     String
  parentId String?

  parent    Topic?     @relation("TopicTree", fields: [parentId], references: [id])
  children  Topic[]    @relation("TopicTree")
  questions Question[]

  @@index([parentId])
}

enum QuestionType {
  SINGLE_CHOICE // the only type the frontend supports today
  MULTIPLE_SELECT // MSQ
  NUMERICAL // NAT
}

enum QuestionStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  RETIRED // never delete a published question, old attempts refer to it
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id               String         @id @default(cuid())
  topicId          String
  type             QuestionType   @default(SINGLE_CHOICE)
  text             String // plain text or LaTeX for formulas
  explanation      String?
  difficulty       Difficulty     @default(MEDIUM)
  numericAnswer    Decimal?       @db.Decimal(18, 6) // for NUMERICAL questions
  numericTolerance Decimal?       @db.Decimal(18, 6)
  status           QuestionStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  topic   Topic            @relation(fields: [topicId], references: [id])
  options QuestionOption[]
  inTests TestQuestion[]
  items   AttemptItem[]

  @@index([topicId, status])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  position   Int // 0, 1, 2, 3
  text       String
  isCorrect  Boolean @default(false) // never sent to the browser before submit

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}

enum TestAccess {
  FREE_DEMO // one free attempt per exam
  PAID // every attempt is paid for
}

model Test {
  id              String        @id @default(cuid())
  examId          String
  slug            String        @unique // used in the URL: /sarav/test/<slug>
  title           String
  access          TestAccess    @default(PAID)
  priceInPaise    Int           @default(0) // price of ONE attempt, 0 for free demos
  currency        String        @default("INR")
  durationMinutes Int
  instructions    String?
  status          PublishStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  exam      Exam           @relation(fields: [examId], references: [id])
  questions TestQuestion[]
  attempts  Attempt[]
  orders    Order[]

  @@index([examId, status])
}

// Which questions are in a test, in what order, and what each one is worth.
// Marks live here, so one test can mix 1-mark and 2-mark questions.
model TestQuestion {
  testId        String
  questionId    String
  position      Int
  marks         Decimal @default(1) @db.Decimal(6, 3)
  negativeMarks Decimal @default(0) @db.Decimal(8, 6) // 1/3 is stored as 0.333333

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([testId, questionId])
  @@unique([testId, position])
}

// =====================================================================
// PAYMENTS: one paid order buys exactly one attempt of one test
// =====================================================================

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  testId            String
  amountInPaise     Int // the price at the moment of purchase, even if the test price changes later
  currency          String      @default("INR")
  status            OrderStatus @default(CREATED)
  provider          String // e.g. "razorpay" or "stripe"
  providerOrderId   String      @unique
  providerPaymentId String?     @unique
  paidAt            DateTime?
  usableUntil       DateTime? // a paid order must be started before this date
  refundedAt        DateTime?
  createdAt         DateTime    @default(now())

  user    User     @relation(fields: [userId], references: [id])
  test    Test     @relation(fields: [testId], references: [id])
  attempt Attempt? // empty until the student starts the test they paid for

  @@index([userId, status])
}

// Every message the payment provider sends. The unique id makes repeated messages harmless.
model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
}

// =====================================================================
// ATTEMPTS
// =====================================================================

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED // the server closed it when the time ran out
}

model Attempt {
  id           String        @id @default(cuid())
  userId       String? // empty for a guest taking the free demo
  guestId      String? // random id kept in a cookie for guests, linked to a user after sign-up
  testId       String
  orderId      String?       @unique // set for paid attempts. Unique: one order buys one attempt
  demoExamId   String? // set only for free demo attempts, see the two unique rules below
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  expiresAt    DateTime // the server's timer: startedAt + the test duration
  submittedAt  DateTime?
  score        Decimal?      @db.Decimal(8, 3)
  maxScore     Decimal?      @db.Decimal(8, 3)
  correctCount Int?
  wrongCount   Int?
  skippedCount Int?

  user  User?  @relation(fields: [userId], references: [id])
  test  Test   @relation(fields: [testId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  items AttemptItem[]

  // One free demo per exam. Postgres treats empty values as different from each other,
  // so these rules only apply to rows where demoExamId is filled in (the free demos).
  @@unique([userId, demoExamId])
  @@unique([guestId, demoExamId])
  @@index([userId, startedAt])
  @@index([testId])
}

// One row per question in an attempt: a snapshot of the question, plus the student's answer.
model AttemptItem {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  position          Int
  snapshot          Json // text, options, correct answers and explanation as they were at the start
  marks             Decimal  @db.Decimal(6, 3)
  negativeMarks     Decimal  @db.Decimal(8, 6)
  selectedOptionIds String[] // empty array means no answer
  numericAnswer     Decimal? @db.Decimal(18, 6)
  markedForReview   Boolean  @default(false)
  isCorrect         Boolean? // filled in when the attempt is submitted
  marksAwarded      Decimal? @db.Decimal(8, 3)

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, position])
}

// =====================================================================
// OTHER
// =====================================================================

enum MessageStatus {
  NEW
  READ
  REPLIED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
}

// Editable page text for the admin panel, e.g. key "home.hero" with the text as JSON.
model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}